# Copy to .env and adjust. docker-compose.yml falls back to these defaults if .env is missing.
POSTGRES_USER=bac
POSTGRES_PASSWORD=bac
POSTGRES_DB=bac
POSTGRES_PORT=5432

# Used by the backend when running outside Docker (inside Docker, compose sets it to point at the db service).
DATABASE_URL=postgresql+psycopg://bac:bac@localhost:5432/bac
